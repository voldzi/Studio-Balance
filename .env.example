# Runtime
APP_ENV=development
APP_VERSION=0.1.0
API_PORT=3001
PUBLIC_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3000/admin
API_URL=http://localhost:3001

# Data
# This value is a public local-only fixture. Production injects a secret URL
# targeting haproxy.home.cz:5000, never a direct database node.
# Production: secret URL must target haproxy.home.cz:5000, never a DB node.
DATABASE_URL=postgresql://studio_balance:local-development-only@localhost:5433/studio_balance

# Optional S3-compatible media storage. Production must use a dedicated Studio Balance
# bucket and credentials; never commit the values below.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Identity and sessions
# Production application: https://studio-balance.cz
# Production issuer: https://login.studio-balance.cz/realms/studio-balance
OIDC_ISSUER_URL=http://localhost:8081/realms/studio-balance
# Only production uses this private server-to-server path when the public
# identity hostname is protected by a CDN/WAF.
OIDC_BACKCHANNEL_ISSUER_URL=
OIDC_WEB_CLIENT_ID=studiobalance-web
OIDC_WEB_CLIENT_SECRET=local-web-client-only
OIDC_ADMIN_CLIENT_ID=studiobalance-admin
OIDC_ADMIN_CLIENT_SECRET=local-admin-client-only
# Public local-only fixture. Production provides a unique value through the secret store.
SESSION_SECRET=local-development-session-secret-change-before-sharing

# Transactional communication
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=

# Observability
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
