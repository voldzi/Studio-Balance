# Runtime
APP_ENV=development
APP_PORT=3000
PUBLIC_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3000/admin
MOBILE_DEEP_LINK_SCHEME=studiobalance

# Data
# Local development: injected by the future Docker Desktop Compose setup.
# Production: secret URL must target haproxy.home.cz:5000, never a DB node.
DATABASE_URL=

# Optional S3-compatible media storage. Local values will come from the future
# Docker Desktop Compose setup. Production must use a dedicated Studio Balance
# bucket and credentials; never commit the values below.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Identity and sessions
SESSION_SECRET=

# Transactional communication
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=
PUSH_PROVIDER_CREDENTIALS=

# Observability
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
