{
  "name": "studio-balance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "pnpm generate:contracts && pnpm -r --if-present build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm validate:repo",
    "db:migrate": "pnpm --filter @studiobalance/api db:migrate",
    "deploy:production": "bash scripts/deploy-production-remote.sh",
    "deploy:preview": "bash scripts/deploy-preview-remote.sh",
    "dev": "pnpm --filter @studiobalance/domain build && pnpm --parallel --filter @studiobalance/web --filter @studiobalance/api --filter @studiobalance/worker dev",
    "dev:api": "pnpm --filter @studiobalance/domain build && pnpm --filter @studiobalance/api dev",
    "dev:web": "pnpm --filter @studiobalance/domain build && pnpm --filter @studiobalance/web dev",
    "dev:worker": "pnpm --filter @studiobalance/worker dev",
    "generate:contracts": "pnpm --filter @studiobalance/contracts generate",
    "infra:down": "docker compose down",
    "infra:up": "docker compose up -d postgres keycloak",
    "preview:config": "docker compose --env-file .env.preview -f docker-compose.preview.yml config --quiet",
    "rollback:preview": "bash scripts/rollback-preview-remote.sh",
    "rollback:production": "bash scripts/rollback-production-remote.sh",
    "lint": "eslint .",
    "test": "pnpm --filter @studiobalance/domain build && pnpm -r --if-present test",
    "typecheck": "pnpm generate:contracts && pnpm -r --if-present typecheck",
    "validate:keycloak-theme": "bash scripts/validate-keycloak-theme.sh",
    "validate:openapi": "python3 -m json.tool openapi/openapi.json >/dev/null",
    "validate:repo": "bash scripts/validate-skeleton.sh && pnpm validate:keycloak-theme && pnpm validate:openapi"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.3.4",
    "@types/node": "26.4.1",
    "eslint": "10.10.0",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
